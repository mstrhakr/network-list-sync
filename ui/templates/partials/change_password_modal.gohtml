{{define "change-password-modal"}}
<div id="changePasswordModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideChangePasswordModal()"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h2>Change Password</h2>
            <button class="modal-close" onclick="hideChangePasswordModal()">&times;</button>
        </div>
        <form id="changePasswordForm" onsubmit="submitChangePassword(event)" style="padding:1rem;">
            <div class="form-group">
                <label for="currentPassword">Current Password</label>
                <input type="password" id="currentPassword" autocomplete="current-password" required>
            </div>
            <div class="form-group">
                <label for="newPassword">New Password</label>
                <input type="password" id="newPassword" minlength="12" autocomplete="new-password" required>
                <span class="hint">Must be at least 12 characters.</span>
            </div>
            <div class="form-group">
                <label for="confirmPassword">Confirm New Password</label>
                <input type="password" id="confirmPassword" minlength="12" autocomplete="new-password" required>
            </div>
            <div style="display:flex;gap:0.5rem;justify-content:flex-end;">
                <button type="button" class="btn btn-secondary" onclick="hideChangePasswordModal()">Cancel</button>
                <button type="submit" class="btn btn-primary">Update Password</button>
            </div>
        </form>
    </div>
</div>
{{end}}
