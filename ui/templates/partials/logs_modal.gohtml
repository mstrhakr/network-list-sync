{{define "logs-modal"}}
<div id="logsModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideLogsModal()"></div>
    <div class="modal-content modal-fixed-shell modal-run-history" role="dialog" aria-modal="true" aria-labelledby="logsModalTitle">
        <div class="modal-header">
            <h2 id="logsModalTitle">Run History</h2>
            <button class="modal-close" aria-label="Close run history" onclick="hideLogsModal()">&times;</button>
        </div>
        <div id="logLimitWrap" class="log-limit-bar logs-toolbar">
            <div class="logs-limit-control">
                <label for="logLimit">Show last</label>
                <select id="logLimit" class="inline-select" onchange="showLogs(activeLogsJobId)">
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="150">150</option>
                    <option value="200">200</option>
                </select>
                <span>runs</span>
            </div>
            <span id="logsSummary" role="status" aria-live="polite"></span>
        </div>
        <div id="logsContent" class="logs-scroll-body" tabindex="0" aria-label="Run history entries"></div>
    </div>
</div>
{{end}}